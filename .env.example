# Copy to .env (never commit .env). Load it into your shell before running anything live.
NEBIUS_API_KEY=paste-your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_STRUCTURED_OUTPUT=0
# Reasoning models spend ~1.5k tokens thinking before the JSON; 400 truncates every call.
NEBIUS_MAX_TOKENS=4096
NEBIUS_TIMEOUT=120
# Optional JSON object merged into each request, e.g. a provider switch to reduce reasoning (check the Nebius docs):
# NEBIUS_EXTRA_BODY={"some_provider_option": "value"}
# Caps on paid model calls (a public URL with a live key can drain credits). Each instruction costs 1 to 2 calls.
USUAL_MAX_CALLS_PER_SESSION=30
USUAL_MAX_CALLS_PER_DAY=400
USUAL_DATA_DIR=./data

# Hosted deployments: set to 1 so missing/placeholder Nebius credentials stop startup with a clear error instead of
# silently using the keyless rule parser. Leave unset locally to keep the keyless demo behaviour.
# USUAL_REQUIRE_LIVE_MODEL=1
