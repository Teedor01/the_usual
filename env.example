# Copy to .env (never commit .env). Load it into your shell before running anything live.
NEBIUS_API_KEY=paste-your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_STRUCTURED_OUTPUT=0
# Reasoning models spend ~1.5k tokens thinking before the JSON; 400 truncates every call.
NEBIUS_MAX_TOKENS=4096
NEBIUS_TIMEOUT=120
# Optional JSON object merged into each request, e.g. a provider switch to reduce reasoning (check the Nebius docs):
# NEBIUS_EXTRA_BODY={"some_provider_option": "value"}
USUAL_DATA_DIR=./data
